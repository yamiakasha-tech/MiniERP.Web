@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MiniERP</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard">
                <span class="bi bi-list-nested-nav-menu"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/clientes">
                <span class="bi bi-list-nested-nav-menu"></span> Clientes
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projetos">
                <span class="bi bi-list-nested-nav-menu"></span> Projetos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/tarefas">
                <span class="bi bi-list-nested-nav-menu"></span> Tarefas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/empregados">
                <span class="bi bi-list-nested-nav-menu"></span> Empregados
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/faturacao">
                <span class="bi bi-list-nested-nav-menu"></span> Faturacao
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-user px-3">
                    <span>@authState.User.Identity?.Name</span>
                </div>

                <div class="nav-item px-3">
                    <form method="post" action="/api/logout">
                        <button type="submit" class="nav-link nav-button">
                            <span class="bi bi-list-nested-nav-menu"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        <span class="bi bi-list-nested-nav-menu"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
