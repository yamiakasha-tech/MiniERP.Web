@page "/empregados"
@rendermode InteractiveServer

@using MiniERP.Web.Models
@using MiniERP.Web.Services

@inject IJSRuntime JS
@inject EmpregadoService EmpregadoService

<h3 class="mb-3">Gestão de Empregados</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarFormulario">
    Novo Empregado
</button>

<!-- Mensagem -->
@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<!-- Tabela -->
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Função</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in empregados)
        {
            <tr @key="emp.Id">
                <td>@emp.Nome</td>
                <td>@emp.Email</td>
                <td>@emp.Funcao</td>
                <td>
                    <button class="btn btn-warning btn-sm me-2"
                            @onclick="() => Editar(emp)">
                        Editar
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="() => Apagar(emp.Id)">
                        Apagar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Formulário -->
@if (mostrarFormulario)
{
    <div class="card p-3 mt-3">
        <h5>@(empregadoAtual.Id == 0 ? "Novo Empregado" : "Editar Empregado")</h5>

        <EditForm Model="empregadoAtual" OnValidSubmit="Guardar">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <InputText class="form-control mb-2"
                       @bind-Value="empregadoAtual.Nome"
                       placeholder="Nome" />

            <InputText class="form-control mb-2"
                       @bind-Value="empregadoAtual.Email"
                       placeholder="Email" />

            <InputText class="form-control mb-2"
                       @bind-Value="empregadoAtual.Funcao"
                       placeholder="Função" />

            <button type="submit" class="btn btn-success me-2">
                Guardar
            </button>

            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                Cancelar
            </button>

        </EditForm>
    </div>
}

@code {

    private List<Empregado> empregados = new();

    private Empregado empregadoAtual = new();
    private bool mostrarFormulario = false;

    private string mensagem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEmpregados();
    }

    /// <summary>
    /// Carrega lista de empregados
    /// </summary>
    private async Task CarregarEmpregados()
    {
        empregados = await EmpregadoService.GetAllAsync();
    }

    private void MostrarFormulario()
    {
        empregadoAtual = new Empregado();
        mostrarFormulario = true;
    }

    private void Editar(Empregado emp)
    {
        empregadoAtual = new Empregado
        {
            Id = emp.Id,
            Nome = emp.Nome,
            Email = emp.Email,
            Funcao = emp.Funcao
        };

        mostrarFormulario = true;
    }

    private async Task Guardar()
    {
        if (empregadoAtual.Id == 0)
        {
            await EmpregadoService.AddAsync(empregadoAtual);
            mensagem = "Empregado criado com sucesso!";
        }
        else
        {
            await EmpregadoService.UpdateAsync(empregadoAtual);
            mensagem = "Empregado atualizado com sucesso!";
        }

        mostrarFormulario = false;
        await CarregarEmpregados();
    }

    private async Task Apagar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "Tens a certeza que queres apagar este empregado?");

        if (!confirmar)
            return;

        await EmpregadoService.DeleteAsync(id);
        mensagem = "Empregado apagado com sucesso!";
        await CarregarEmpregados();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}
