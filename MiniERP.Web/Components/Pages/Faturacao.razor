@page "/faturacao"
@rendermode InteractiveServer

@using MiniERP.Web.Models
@using MiniERP.Web.Services

@inject IJSRuntime JS
@inject FaturaService FaturaService
@inject ProjetoService ProjetoService

<h3 class="mb-3">Faturação</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarFormulario">
    Nova Fatura
</button>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Projeto</th>
            <th>Data</th>
            <th>Total (€)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in faturas)
        {
            <tr @key="f.Id">
                <td>@f.Projeto?.Nome</td>
                <td>@f.Data.ToShortDateString()</td>
                <td>@f.Total</td>
                <td>
                    <button class="btn btn-warning btn-sm me-2"
                            @onclick="() => Editar(f)">
                        Editar
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="() => Apagar(f.Id)">
                        Apagar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (mostrarFormulario)
{
    <div class="card p-3 mt-3">
        <h5>@(faturaAtual.Id == 0 ? "Nova Fatura" : "Editar Fatura")</h5>

        <EditForm Model="faturaAtual" OnValidSubmit="Guardar">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Projeto -->
            <InputSelect class="form-control mb-2"
                         @bind-Value="faturaAtual.ProjetoId">

                <option value="0">Seleciona Projeto</option>

                @foreach (var p in projetos)
                {
                    <option value="@p.Id">@p.Nome</option>
                }
            </InputSelect>

            <!-- Data -->
            <InputDate class="form-control mb-2"
                       @bind-Value="faturaAtual.Data" />

            <!-- Total -->
            <InputNumber class="form-control mb-2"
                         @bind-Value="faturaAtual.Total" />

            <button type="submit" class="btn btn-success me-2">
                Guardar
            </button>

            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                Cancelar
            </button>

        </EditForm>
    </div>
}

@code {

    private List<Fatura> faturas = new();
    private List<Projeto> projetos = new();

    private Fatura faturaAtual = new();
    private bool mostrarFormulario = false;

    private string mensagem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        faturas = await FaturaService.GetAllAsync();
        projetos = await ProjetoService.GetAllAsync();
    }

    private void MostrarFormulario()
    {
        faturaAtual = new Fatura();
        mostrarFormulario = true;
    }

    private void Editar(Fatura f)
    {
        faturaAtual = new Fatura
        {
            Id = f.Id,
            ProjetoId = f.ProjetoId,
            Data = f.Data,
            Total = f.Total
        };

        mostrarFormulario = true;
    }

    private async Task Guardar()
    {
        if (faturaAtual.Id == 0)
        {
            await FaturaService.AddAsync(faturaAtual);
            mensagem = "Fatura criada com sucesso!";
        }
        else
        {
            await FaturaService.UpdateAsync(faturaAtual);
            mensagem = "Fatura atualizada com sucesso!";
        }

        mostrarFormulario = false;
        await CarregarDados();
    }

    private async Task Apagar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "Tens a certeza que queres apagar esta fatura?");

        if (!confirmar)
            return;

        await FaturaService.DeleteAsync(id);
        mensagem = "Fatura apagada com sucesso!";
        await CarregarDados();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}
